# ============================================================
# Barbets Duet — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel.
# NEXT_PUBLIC_* are exposed to the browser; the rest are server-only secrets.
# ============================================================

# ── Supabase (auth + Postgres) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://qomnuladxmiszlyqtvkx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only — admin role updates + migrations

# ── Sanity (CMS) ──────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=xdhl8m8i
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=                   # read/viewer token (admin queries)
SANITY_WRITE_TOKEN=                 # editor token — T&E publish / content writes
SANITY_WEBHOOK_SECRET=              # validates the revalidation webhook

# ── Maps (Stadia) ─────────────────────────────────────────
NEXT_PUBLIC_STADIA_API_KEY=

# ── Analytics (Umami) ─────────────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Payments (Stripe) ─────────────────────────────────────
STRIPE_SECRET_KEY=

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=

# ── Realtime (Liveblocks) ─────────────────────────────────
LIVEBLOCKS_SECRET_KEY=
LIVEBLOCKS_WEBHOOK_SECRET=          # signing secret for /api/liveblocks-webhook

# ── Security (Arcjet) ─────────────────────────────────────
ARCJET_KEY=

# ── AI search (Vercel AI Gateway) ─────────────────────────
# On Vercel, auth is automatic via OIDC. For local dev set the key from
# the Vercel dashboard (AI Gateway → API keys).
AI_GATEWAY_API_KEY=
SEARCH_MODEL=openai/gpt-4o-mini      # any "provider/model" gateway string

# ── Payments (PayPal) ─────────────────────────────────────
# Client ID + mode can also be set at /admin/settings (DB overrides env).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=                       # env only — never stored in DB

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://barbets-duet.vercel.app   # prod / custom domain
