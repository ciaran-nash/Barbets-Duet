# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Umami Analytics (privacy-first, cookieless — no GDPR consent banner needed)
# Get this from the Umami Cloud dashboard (umami.is) after creating a
# "Barbets Duet" website entry. Only required in production.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id-here

# Stadia Maps (interactive learning sites map)
# Get API key from https://client.stadiamaps.com/dashboard/
# Without this key the map falls back to open MapLibre demo tiles (dev only).
NEXT_PUBLIC_STADIA_API_KEY=your-stadia-api-key-here

# Arcjet (https://app.arcjet.com) — bot protection + rate limiting
# Create a free account, add a site, and paste the API key here.
# ARCJET_KEY=ajkey_your-key-here

# Stripe (https://dashboard.stripe.com) — payments
# One-time donations only. Monthly giving requires pre-created Stripe Price objects (post-launch).
# STRIPE_SECRET_KEY=sk_test_your-key-here
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Resend (https://resend.com) — transactional email
# Create a free account (3,000 emails/month free tier).
# Add the RESEND_API_KEY from the Resend dashboard.
# Domain verification for barbetsduet.org is required before emails can be sent
# from noreply@barbetsduet.org. See lib/email/resend.ts for DNS setup instructions.
# RESEND_API_KEY=re_your-key-here

# Sanity CMS (https://sanity.io) — content management
# 1. Create a free Sanity account at sanity.io
# 2. Create a new project (name it "Barbets Duet", dataset: "production")
# 3. Find your Project ID in: sanity.io/manage → your project → Settings → API
# 4. Create API tokens: Settings → API → Tokens — "Viewer" for SANITY_API_TOKEN, "Editor" for SANITY_WRITE_TOKEN
# 5. Invite Barbets Duet staff at: Settings → Members
# NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=your-sanity-read-token
# SANITY_WRITE_TOKEN=your-sanity-editor-token  # manage.sanity.io → API → Tokens → Editor role — needed for server-side mutations
# SANITY_WEBHOOK_SECRET=your-webhook-secret  # set this when configuring T21 webhooks

# Supabase (https://supabase.com) — database + auth
# Get from: supabase.com/dashboard → project → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server-side only — never expose to browser

# OpenRouter (https://openrouter.ai) — AI-powered site search
# Create a free account at openrouter.ai — no credit card required for free models.
# Free models available: meta-llama/llama-3.1-8b-instruct:free, google/gemma-2-9b-it:free
# Powers the POST /api/search endpoint for learning site discovery.
# OPENROUTER_API_KEY=sk-or-your-key-here
