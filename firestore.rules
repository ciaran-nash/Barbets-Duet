rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid && request.auth.token.email_verified == true; }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'createdAt', 'updatedAt']) 
        && data.displayName is string && data.displayName.size() <= 100
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && data.createdAt is number
        && data.updatedAt is number;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // No blanket reads

      allow create: if isOwner(userId) && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().keys().size() <= 4 // displayName, createdAt, updatedAt, bio
                    && incoming().createdAt == request.time.toMillis()
                    && incoming().updatedAt == request.time.toMillis();
                    
      allow update: if isOwner(userId) && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'updatedAt'])
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time.toMillis();

      allow delete: if isOwner(userId) && isValidId(userId);

      match /saved_events/{eventId} {
        function isValidSavedEvent(data) {
          return data.keys().hasAll(['eventId', 'title', 'date', 'savedAt'])
            && data.eventId is string && data.eventId.size() <= 128
            && data.title is string && data.title.size() <= 200
            && data.date is string && data.date.size() <= 50
            && data.savedAt is number;
        }

        allow get: if isOwner(userId) && isValidId(userId) && isValidId(eventId);
        allow list: if isOwner(userId) && isValidId(userId);
        
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(eventId)
                      && isValidSavedEvent(incoming())
                      && incoming().keys().size() == 4
                      && incoming().savedAt == request.time.toMillis()
                      && incoming().eventId == eventId;

        allow update: if false; // Saved events are not updatable, only deletable/re-creatable

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(eventId);
      }
    }
  }
}
